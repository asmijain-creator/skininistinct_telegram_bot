# Copy this file to .env for local scripts, and add the same values
# in Vercel → Project → Settings → Environment Variables.
# Keep this file empty — it gets committed. Real values go in .env only.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Any long random string you make up (letters, numbers, _ and - only).
# Telegram sends it with every webhook call so strangers can't hit your endpoint.
TELEGRAM_WEBHOOK_SECRET=

# Meera's Telegram chat ID. Leave empty at first, send /start to the bot,
# and it will reply with the ID to put here. Comma-separate to allow several.
ALLOWED_CHAT_IDS=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model that supports generateContent.
GEMINI_MODEL=gemini-3.6-flash
